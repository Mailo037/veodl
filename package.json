{
  "name": "veodl",
  "version": "2.0.0",
  "description": "A clean, simple video downloader powered by yt-dlp. Native binary; no Node.js needed at runtime.",
  "type": "module",
  "bin": {
    "veo": "bin/veo.js",
    "veodl": "bin/veo.js"
  },
  "files": [
    "bin/",
    "docs/",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "cargo test",
    "build": "cargo build --release",
    "check:package": "node scripts/check-package.js",
    "packages": "node scripts/npm-packages.mjs"
  },
  "keywords": [
    "cli",
    "video",
    "downloader",
    "yt-dlp",
    "audio",
    "youtube",
    "playlist",
    "subtitles"
  ],
  "license": "MIT",
  "author": "Mailo037",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mailo037/veodl.git"
  },
  "bugs": {
    "url": "https://github.com/Mailo037/veodl/issues"
  },
  "homepage": "https://github.com/Mailo037/veodl#readme",
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "veodl-win32-x64": "2.0.0",
    "veodl-win32-arm64": "2.0.0",
    "veodl-darwin-x64": "2.0.0",
    "veodl-darwin-arm64": "2.0.0",
    "veodl-linux-x64": "2.0.0",
    "veodl-linux-arm64": "2.0.0",
    "veodl-android-arm64": "2.0.0"
  }
}
